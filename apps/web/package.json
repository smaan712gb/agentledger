{
  "name": "@agentledger/web",
  "version": "0.1.0",
  "private": true,
  "description": "The AgentLedger web app (backlog F-10): a React single-page app served next to the API.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "size": "size-limit",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size"
  },
  "dependencies": {
    "@agentledger/contracts": "*",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@radix-ui/react-visually-hidden": "^1.2.12",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@size-limit/file": "^14.2.0",
    "@tanstack/router-plugin": "^1.168.42",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.11.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "msw": "^3.0.2",
    "otpauth": "^9.5.2",
    "prettier": "^3.9.0",
    "size-limit": "^14.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  }
}
