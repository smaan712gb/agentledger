# Copy to .env (git-ignored) and fill in. On GitHub, add the same names as repository secrets
# (Settings -> Secrets and variables -> Actions). Production on Cloudflare uses Worker/Container secrets.

# Legislation watchers (free)
OPENSTATES_API_KEY=          # https://openstates.org -> profile
DATA_GOV_API_KEY=            # https://api.data.gov/signup

# Cloudflare: Workers AI inventory now; deploys, AI Gateway and R2 later
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Frontier model tier (optional; consent-gated for taxpayer data, ADR-0007)
ANTHROPIC_API_KEY=

# Platform (multi-firm mode). Generate with: agentledger platform new-master-key
AGENTLEDGER_MASTER_KEY=

# Evidence storage (F-06): "file" (default, local directory) or "s3" (Cloudflare R2 in production).
AGENTLEDGER_BLOBS=file
AGENTLEDGER_BLOB_ENDPOINT=          # https://<account>.r2.cloudflarestorage.com
AGENTLEDGER_BLOB_BUCKET=
AGENTLEDGER_BLOB_ACCESS_KEY_ID=
AGENTLEDGER_BLOB_SECRET_ACCESS_KEY=

# Later (backlog F-04 / F-05): Neon and WorkOS
NEON_API_KEY=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# "workos": firm users sign in through WorkOS AuthKit; "local" (default): password + TOTP (self-hosting).
AGENTLEDGER_IDENTITY=local
# The callback registered in the WorkOS dashboard, e.g. https://app.example.com/api/auth/idp/callback
WORKOS_REDIRECT_URI=

# Firm data store: "sqlite" (local demo, default) or "postgres" (the database enforces the posting rules).
# PostgreSQL needs DATABASE_URL_UNPOOLED (direct endpoint) for migrations and the app role session settings.
AGENTLEDGER_DATABASE=sqlite
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Owner credentials (migrations and provisioning only; production keeps them out of the API's environment).
AGENTLEDGER_MIGRATION_URL=
# Runtime connections: host and database only (credentials are replaced by the store's own runtime role).
AGENTLEDGER_RUNTIME_DATABASE_URL=
# Runtime role passwords are derived from this key (development falls back to the owner password).
AGENTLEDGER_DB_ROLE_KEY=
# Outside dev mode the API refuses SQLite unless this is 1 (self-hosted trial only).
AGENTLEDGER_ALLOW_SQLITE=0
# PostgreSQL tenancy: "schema" (one database, a schema per firm) or "database" (a Neon database per firm).
AGENTLEDGER_PG_TENANCY=schema
# Needed for database tenancy: the Neon API key, project id and branch (name or id).
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH=
